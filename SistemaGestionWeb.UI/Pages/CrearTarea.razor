@page "/CrearTarea"
@layout MainLayout
@inject DataService DataSvc
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="vista-container py-4" style="max-width: 1350px; width: 100%; margin: 0 auto; padding-left: 1rem; padding-right: 1rem; box-sizing: border-box;">
    <!-- Cabecera -->
    <div style="margin-bottom: 2rem;">
        <h2 style="font-weight: 800; color: #f8fafc; margin-bottom: 0.5rem; font-size: 1.75rem;">Registrar Nueva Tarea Operativa</h2>
        <p style="color: #94a3b8; font-size: 0.95rem; margin: 0;">Crea y asigna tareas operativas para las organizaciones donde posees privilegios de administración.</p>
    </div>

    <!-- Mensaje de Feedback -->
    @if (!string.IsNullOrEmpty(mensajeFeedback))
    {
        <div style="margin-bottom: 1.5rem; padding: 1rem; border-radius: 8px; background-color: @(esError ? "rgba(239, 68, 68, 0.2)" : "rgba(16, 185, 129, 0.2)"); border: 1px solid @(esError ? "#ef4444" : "#10b981"); color: @(esError ? "#fca5a5" : "#6ee7b7");">
            @mensajeFeedback
        </div>
    }

    <!-- Contenedor del Formulario en Tarjeta -->
    <div style="background-color: #1e293b; border: 1px solid #334155; padding: 1.25rem; border-radius: 16px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); width: 100%; box-sizing: border-box;">
        
        @if (cargando)
        {
            <div style="text-align: center; color: #94a3b8; padding: 2rem;">Cargando tus organizaciones...</div>
        }
        else if (organizacionesAdmin == null || !organizacionesAdmin.Any())
        {
            <div style="text-align: center; padding: 2rem; color: #94a3b8;">
                <i class="bi bi-shield-lock" style="font-size: 2.5rem; color: #f59e0b; margin-bottom: 1rem; display: block;"></i>
                <h3 style="color: #f8fafc; margin-bottom: 0.5rem;">Sin privilegios de administración</h3>
                <p style="font-size: 0.95rem; margin-bottom: 1.5rem;">No posees el rol de administrador en ninguna organización activa actualmente, por lo que no puedes crear tareas.</p>
            </div>
        }
        else
        {
            <form @onsubmit="GuardarTareaAsync" style="display: flex; flex-direction: column; gap: 1.25rem; width: 100%; box-sizing: border-box;">
                
                <!-- Organización -->
                <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
                    <label style="color: #cbd5e1; font-weight: 600; font-size: 0.9rem;">Organización (Donde eres Admin)</label>
                    <select @key="renderKey" @value="orgSeleccionadaId" @onchange="CambiarOrganizacion" style="background: #0f172a; color: #f8fafc; border: 1px solid #334155; padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.95rem; outline: none; width: 100%; max-width: 100%; box-sizing: border-box; cursor: pointer;">
                        <option value="">-- Selecciona una organización --</option>
                        @foreach (var org in organizacionesAdmin)
                        {
                            <option value="@org.IdOrganizacion">@org.NombreOrganizacion</option>
                        }
                    </select>
                </div>

                <!-- Categoría de la Tarea + Botón Nueva (Se envuelven automáticamente si falta espacio) -->
                <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
                    <label style="color: #cbd5e1; font-weight: 600; font-size: 0.9rem;">Categoría de la Tarea</label>
                    <div style="display: flex; gap: 0.5rem; width: 100%; flex-wrap: wrap;">
                        <select @bind="categoriaSeleccionadaId" style="background: #0f172a; color: #f8fafc; border: 1px solid #334155; padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.95rem; outline: none; flex: 1 1 200px; min-width: 0; box-sizing: border-box; cursor: pointer;">
                            <option value="0">-- Selecciona una categoría --</option>
                            @foreach (var cat in categoriasDisponibles)
                            {
                                <option value="@cat.Id">@cat.Nombre</option>
                            }
                        </select>
                        <button type="button" @onclick="AbrirModalNuevaCategoria" style="background: #334155; color: #38bdf8; border: 1px solid #475569; padding: 0.75rem 1rem; border-radius: 8px; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.25rem; white-space: nowrap; flex: 0 0 auto;">
                            <i class="bi bi-plus-lg"></i> Nueva
                        </button>
                    </div>
                </div>

                <!-- Modal o Sección rápida para crear Categoría si está activa -->
                @if (mostrandoInputCategoria)
                {
                    <div style="background: #0f172a; padding: 1rem; border: 1px solid #334155; border-radius: 8px; display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; width: 100%; box-sizing: border-box;">
                        <input type="text" @bind="nuevaCategoriaNombre" placeholder="Nombre de nueva categoría..." style="background: #1e293b; color: #f8fafc; border: 1px solid #334155; padding: 0.5rem; border-radius: 6px; flex: 1; min-width: 200px; box-sizing: border-box;" />
                        <button type="button" @onclick="CrearCategoriaAsync" style="background: #10b981; color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 600; cursor: pointer;">Guardar Categoría</button>
                        <button type="button" @onclick="() => mostrandoInputCategoria = false" style="background: #475569; color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 6px; cursor: pointer;">Cancelar</button>
                    </div>
                }

                <!-- Título de la Tarea -->
                <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
                    <label style="color: #cbd5e1; font-weight: 600; font-size: 0.9rem;">Título de la Tarea</label>
                    <input type="text" @bind="tituloTarea" placeholder="Ej: Revisión de stock..." style="background: #0f172a; color: #f8fafc; border: 1px solid #334155; padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.95rem; outline: none; width: 100%; max-width: 100%; box-sizing: border-box;" />
                </div>

                <!-- Prioridad -->
                <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
                    <label style="color: #cbd5e1; font-weight: 600; font-size: 0.9rem;">Prioridad</label>
                    <select @bind="prioridadTarea" style="background: #0f172a; color: #f8fafc; border: 1px solid #334155; padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.95rem; outline: none; width: 100%; max-width: 100%; box-sizing: border-box; cursor: pointer;">
                        <option value="Normal">Normal</option>
                        <option value="Alta">Alta</option>
                        <option value="Urgente">Urgente</option>
                    </select>
                </div>

                <!-- Descripción -->
                <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
                    <label style="color: #cbd5e1; font-weight: 600; font-size: 0.9rem;">Descripción y Detalles</label>
                    <textarea @bind="descripcionTarea" rows="4" placeholder="Describa los detalles de la tarea..." style="background: #0f172a; color: #f8fafc; border: 1px solid #334155; padding: 0.75rem 1rem; border-radius: 8px; font-size: 0.95rem; outline: none; width: 100%; max-width: 100%; box-sizing: border-box; resize: vertical;"></textarea>
                </div>

                <!-- Botones de Acción -->
                <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1rem; border-top: 1px solid #334155; padding-top: 1.5rem; flex-wrap: wrap; width: 100%;">
                    <button type="button" @onclick="Cancelar" style="background: transparent; color: #94a3b8; border: 1px solid #334155; padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 600; cursor: pointer; flex: 1; min-width: 120px;">
                        Cancelar
                    </button>
                    <button type="submit" style="background: #38bdf8; color: #0f172a; border: none; padding: 0.75rem 1.75rem; border-radius: 8px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; flex: 1; min-width: 140px;">
                        <i class="bi bi-check-lg"></i> Guardar Tarea
                    </button>
                </div>

            </form>
        }
    </div>
</div>

@code {
    private int usuarioIdActual = 0;
    private bool cargando = true;
    private bool esError = false;
    private string mensajeFeedback = "";

    private List<OrgConMiembrosDto> organizacionesAdmin = new();
    private string orgSeleccionadaId = "";

    private List<Categoria> categoriasDisponibles = new();
    private int categoriaSeleccionadaId = 0;

    private bool mostrandoInputCategoria = false;
    private string nuevaCategoriaNombre = "";
    private string nuevoColorHex = "#3B82F6";

    private string tituloTarea = "";
    private string descripcionTarea = "";
    private string prioridadTarea = "Normal";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosInicialesAsync();
    }

    private async Task CargarDatosInicialesAsync()
    {
        cargando = true;
        try
        {
            string idStr = await JS.InvokeAsync<string>("localStorage.getItem", "usuario_id");
            if (int.TryParse(idStr, out int uId))
            {
                usuarioIdActual = uId;
                var todasOrgs = await DataSvc.ObtenerOrganizacionesParaPerfilAsync(uId);

                // Filtramos estrictamente donde sea Administrador
                organizacionesAdmin = todasOrgs.Where(o => 
                    o.RolUsuarioActual.Equals("admin", StringComparison.OrdinalIgnoreCase) || 
                    o.RolUsuarioActual.Equals("administrador", StringComparison.OrdinalIgnoreCase)
                ).ToList();

                if (organizacionesAdmin.Any())
                {
                    orgSeleccionadaId = organizacionesAdmin.First().IdOrganizacion.ToString();
                    await CargarCategoriasAsync();
                }
            }
        }
        catch (Exception ex)
        {
            mensajeFeedback = $"Error al cargar datos iniciales: {ex.Message}";
            esError = true;
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CambiarOrganizacion(ChangeEventArgs e)
    {
        orgSeleccionadaId = e.Value?.ToString() ?? "";
        categoriaSeleccionadaId = 0;
        await CargarCategoriasAsync();
    }

    private async Task CargarCategoriasAsync()
    {
        try
        {
            if (!string.IsNullOrEmpty(orgSeleccionadaId))
            {
                categoriasDisponibles = await DataSvc.ObtenerCategoriasAsync(orgSeleccionadaId);
            }
            else
            {
                categoriasDisponibles.Clear();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar categorías: {ex.Message}");
        }
    }

    private void AbrirModalNuevaCategoria()
    {
        if (string.IsNullOrEmpty(orgSeleccionadaId))
        {
            mensajeFeedback = "Primero debes seleccionar una organización.";
            esError = true;
            return;
        }
        nuevaCategoriaNombre = "";
        nuevoColorHex = "#3B82F6";
        mostrandoInputCategoria = true;
    }

    private async Task CrearCategoriaAsync()
    {
        if (string.IsNullOrWhiteSpace(nuevaCategoriaNombre)) return;

        if (categoriasDisponibles.Any(c => c.Nombre.Equals(nuevaCategoriaNombre.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            mensajeFeedback = "La categoría ya existe.";
            esError = true;
            return;
        }

        try
        {
            var nuevaCatCreada = await DataSvc.CrearCategoriaAsync(nuevaCategoriaNombre.Trim(), nuevoColorHex, orgSeleccionadaId);

            if (nuevaCatCreada != null)
            {
                categoriasDisponibles.Add(nuevaCatCreada);
                categoriaSeleccionadaId = nuevaCatCreada.Id;
                mostrandoInputCategoria = false;
                mensajeFeedback = "Categoría creada con éxito.";
                esError = false;
            }
            else
            {
                mensajeFeedback = "No se pudo crear la categoría en Supabase.";
                esError = true;
            }
        }
        catch (Exception ex)
        {
            mensajeFeedback = $"Error al crear categoría: {ex.Message}";
            esError = true;
        }
    }

    private async Task GuardarTareaAsync()
    {
        if (string.IsNullOrEmpty(orgSeleccionadaId) || 
        categoriaSeleccionadaId == 0 || 
        string.IsNullOrWhiteSpace(tituloTarea) || 
        string.IsNullOrWhiteSpace(descripcionTarea))
    {
        mensajeFeedback = "Debes completar todos los campos obligatorios (Organización, Categoría, Título y Descripción).";
        esError = true;
        StateHasChanged(); 

        await Task.Delay(3000);

        mensajeFeedback = string.Empty;
        esError = false;
        StateHasChanged(); 
        
        return; 
    }

        try
        {
            var nuevaTarea = new Registro
            {
                Titulo = tituloTarea.Trim(),
                Descripcion = descripcionTarea?.Trim() ?? "",
                CategoriaId = categoriaSeleccionadaId,
                OrganizacionId = orgSeleccionadaId,
                EstadoId = 1
            };

            bool guardado = await DataSvc.CrearTareaAsync(nuevaTarea);

            if (guardado)
            {
                mensajeFeedback = "¡Tarea registrada con éxito!";
                esError = false;
                LimpiarFormulario();
                StateHasChanged(); 

                await Task.Delay(2000);

                mensajeFeedback = string.Empty;
                StateHasChanged(); 
            }
            else
            {
                mensajeFeedback = "No se pudo guardar la tarea en Supabase.";
                esError = true;
            }
        }
        catch (Exception ex)
        {
            mensajeFeedback = $"Error: {ex.Message}";
            esError = true;
        }
    }

    private void LimpiarFormulario()
    {
        tituloTarea = "";
        descripcionTarea = "";
        prioridadTarea = "Normal";
        categoriaSeleccionadaId = 0;
    }
    private int renderKey = 0;
    private void Cancelar()
    {
        tituloTarea = string.Empty;
        descripcionTarea = string.Empty;
        orgSeleccionadaId = string.Empty;
        categoriaSeleccionadaId = 0;
        prioridadTarea = "Normal";
        mensajeFeedback = string.Empty;
        
        
        renderKey++; 
        
        StateHasChanged();
    }
}