@inherits LayoutComponentBase

<div class="welcome-layout-container">
    
    <div class="welcome-info-column" style="display: flex; flex-direction: column; justify-content: center;">
        <div style="max-width: 580px; width: 100%; margin: 0 auto; display: flex; flex-direction: column; align-items: flex-start;">
            
            <div style="display: flex; align-items: center; margin-bottom: 25px;">
                <img src="images/logo.png" alt="SIGEOP Logo" style="height: 140px; width: auto; object-fit: contain; border-radius: 8px;" />
            </div>
        
            <h1 class="welcome-title">Control de Turnos y Equipos Operativos</h1>
            
            <p class="welcome-subtitle" style="font-size: 1.15rem; line-height: 1.6; margin-bottom: 35px;">
                Administre múltiples Tareas de la operación en tiempo real con este Sistema de Gestion Operativa. Organize tareas mediante tableros de control, controle entregables del personal y mantenga la trazabilidad diaria de sus operaciones.
            </p>

            <div style="display: flex; flex-direction: column; gap: 20px; width: 100%;">
                <div style="display: flex; align-items: flex-start; gap: 16px;">
                    <div style="background-color: #dbeafe; color: #1d4ed8; font-weight: 700; width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1rem;">1</div>
                    <div>
                        <h4 style="margin: 0 0 4px 0; font-size: 1.05rem; font-weight: 700; color: #1e293b;">Gestión Multiorganización</h4>
                        <p style="margin: 0; font-size: 0.95rem; color: #64748b; line-height: 1.4;">Acceso descentralizado por cada local o unidad operativa independientemente.</p>
                    </div>
                </div>

                <div style="display: flex; align-items: flex-start; gap: 16px;">
                    <div style="background-color: #d1fae5; color: #065f46; font-weight: 700; width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1rem;">2</div>
                    <div>
                        <h4 style="margin: 0 0 4px 0; font-size: 1.05rem; font-weight: 700; color: #1e293b;">Tablero Operativo en Tiempo Real</h4>
                        <p style="margin: 0; font-size: 0.95rem; color: #64748b; line-height: 1.4;">Flujo estructurado para seguimiento de estados y prioridades.</p>
                    </div>
                </div>

                <div style="display: flex; align-items: flex-start; gap: 16px;">
                    <div style="background-color: #fef3c7; color: #92400e; font-weight: 700; width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1rem;">3</div>
                    <div>
                        <h4 style="margin: 0 0 4px 0; font-size: 1.05rem; font-weight: 700; color: #1e293b;">Control de Accesos por Equipo</h4>
                        <p style="margin: 0; font-size: 0.95rem; color: #64748b; line-height: 1.4;">Asignación de roles y vinculación mediante códigos de grupo para el personal.</p>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="welcome-form-column">
        @Body
    </div>

</div>


<style>
    .welcome-layout-container {
        min-height: 100vh;
        width: 100vw;
        background-color: #f8fafc;
        color: #0f172a;
        display: flex;
        justify-content: center;
        align-items: flex-start; 
        margin: 0;
        padding: 4rem 2rem 2rem 2rem; 
        box-sizing: border-box;
        overflow-y: auto;
    }

    .welcome-content-wrapper {
        display: flex;
        max-width: 1100px;
        width: 100%;
        gap: 4rem;
        align-items: flex-start; 
        justify-content: space-between;
    }

    .welcome-info-column {
        flex: 1;
        max-width: 540px;
    }

    .badge-sistema {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        color: #ffffff;
        background-color: #2563eb;
        padding: 0.35rem 0.85rem;
        border-radius: 6px;
        margin-bottom: 1.25rem;
    }

    .welcome-title {
        font-size: 2.25rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.2;
        margin-bottom: 1rem;
    }

    .welcome-subtitle {
        font-size: 0.95rem;
        color: #475569;
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .feature-list {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .feature-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
    }

    .feature-number {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

    .bg-blue { background-color: #dbeafe; color: #1d4ed8; }
    .bg-green { background-color: #dcfce7; color: #15803d; }
    .bg-yellow { background-color: #fef9c3; color: #a16207; }

    .feature-title {
        font-weight: 700;
        font-size: 0.9rem;
        color: #1e293b;
    }

    .feature-desc {
        font-size: 0.825rem;
        color: #64748b;
    }

    .welcome-form-column {
        flex: 1;
        max-width: 440px;
        display: flex;
        justify-content: center;
    }

    @@media (max-width: 968px) {
        .welcome-content-wrapper {
            flex-direction: column;
            gap: 2rem;
        }
        .welcome-info-column {
            max-width: 100%;
            text-align: left;
        }
        .welcome-form-column {
            max-width: 100%;
            width: 100%;
        }
    }
</style>