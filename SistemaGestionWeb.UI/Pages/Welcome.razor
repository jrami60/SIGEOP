@page "/welcome"
@layout EmptyLayout
@inject DataService DataSvc
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.ComponentModel.DataAnnotations

<div class="card shadow-sm border-0 p-4" style="width: 100%; max-width: 420px; border-radius: 1rem; background-color: #ffffff;">
    
    <div class="text-center mb-4">
        <h3 class="fw-bold text-dark mb-1" style="font-size: 1.75rem;">Crear Cuenta</h3>
        <p class="text-muted small">Tablero de Turnos</p>
    </div>

    @if (registroExitoso)
    {
        <div class="alert alert-success text-center py-4 rounded-3 shadow-sm" role="alert">
            <h5 class="fw-bold text-success mb-2">¡Registro Exitoso!</h5>
            <p class="text-dark small mb-0">Su cuenta ha sido creada correctamente en el sistema. Redirigiendo al inicio de sesión...</p>
        </div>
    }
    else
    {
        <EditForm Model="@usuarioRegistro" OnValidSubmit="ProcesarRegistro">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label text-dark fw-semibold small">Nombre Completo</label>
                <InputText @bind-Value="usuarioRegistro.Nombre" class="form-control" placeholder="" />
                <ValidationMessage For="@(() => usuarioRegistro.Nombre)" class="text-danger small mt-1" />
            </div>

            <div class="mb-3">
                <label class="form-label text-dark fw-semibold small">Correo Electrónico</label>
                <InputText @bind-Value="usuarioRegistro.Email" class="form-control" placeholder="" />
                <ValidationMessage For="@(() => usuarioRegistro.Email)" class="text-danger small mt-1" />
            </div>

            <div class="mb-3">
                <label class="form-label text-dark fw-semibold small">Contraseña</label>
                <InputText @bind-Value="usuarioRegistro.Password" type="password" class="form-control" placeholder="••••••" />
                <ValidationMessage For="@(() => usuarioRegistro.Password)" class="text-danger small mt-1" />
            </div>

            <div class="mb-4">
                <label class="form-label text-dark fw-semibold small">Confirmar Contraseña</label>
                <InputText @bind-Value="usuarioRegistro.ConfirmPassword" type="password" class="form-control" placeholder="••••••" />
                <ValidationMessage For="@(() => usuarioRegistro.ConfirmPassword)" class="text-danger small mt-1" />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm">Registrarse en el Sistema</button>

            <div class="text-center mt-3">
                <span class="text-muted small">¿Ya tienes una cuenta? </span>
                <a href="/login" class="text-primary small text-decoration-none fw-bold">Inicia sesión aquí</a>
            </div>
        </EditForm>
    }
</div>

@code {
    private UsuarioRegistroDto usuarioRegistro = new();
    private bool registroExitoso = false;

    private async Task ProcesarRegistro()
    {
        if (usuarioRegistro.Password != usuarioRegistro.ConfirmPassword)
        {
            await JS.InvokeVoidAsync("alert", "Las contraseñas no coinciden.");
            return;
        }

        bool exito = await DataSvc.RegistrarUsuarioAsync(usuarioRegistro.Nombre, usuarioRegistro.Email, usuarioRegistro.Password);

        if (exito)
        {
            registroExitoso = true;
            StateHasChanged();
            await Task.Delay(2000);
            Navigation.NavigateTo("/login");
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Hubo un error al registrar el usuario en Supabase.");
        }
    }

    public class UsuarioRegistroDto
    {
        [Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Nombre { get; set; } = "";

        [Required(ErrorMessage = "El email es obligatorio."), EmailAddress(ErrorMessage = "Formato de email inválido.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "La contraseña es obligatoria."), MinLength(6, ErrorMessage = "Mínimo 6 caracteres.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Confirme la contraseña.")]
        public string ConfirmPassword { get; set; } = "";
    }
}