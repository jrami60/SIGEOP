@page "/tareas-programadas"
@inject NavigationManager Navigation
@inject DataService DataService
@inject IJSRuntime JS

<div style="width: 100%; box-sizing: border-box;">

    <!-- Selector de Organización Activa Dinámico -->
    <div style="background-color: #1e293b; padding: 1.25rem; border-radius: 12px; border: 1px solid #334155; display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; box-sizing: border-box; width: 100%;">
        <span style="color: #94a3b8; font-weight: 600; font-size: 0.9rem;">Organización Activa:</span>
        
        <div style="position: relative; width: 100%;">
            <select @onchange="CambiarOrganizacion" style="width: 100%; background-color: #0f172a; color: #38bdf8; border: 1px solid #334155; padding: 0.75rem 1rem; border-radius: 8px; font-size: 1rem; font-weight: 600; outline: none; cursor: pointer; appearance: none;">
                @if (listaOrganizaciones != null)
                {
                    @foreach (var org in listaOrganizaciones)
                    {
                        <option value="@org.Id" selected="@(org.Id == orgActual)">@org.Nombre</option>
                    }
                }
            </select>
            <span style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); color: #38bdf8; pointer-events: none; font-size: 0.9rem;">▼</span>
        </div>

        <div style="color: #94a3b8; font-size: 0.85rem; margin-top: 0.25rem;">
            Mostrando datos para: <span style="color: #f8fafc; font-weight: 600;">@ObtenerNombreOrganizacionActiva()</span>
        </div>
    </div>

    <!-- Tarjetas de Métricas (KPIs) -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1rem; width: 100%; box-sizing: border-box;">
        
        <div style="background-color: #1e293b; border: 1px solid #334155; padding: 1.25rem; border-radius: 12px; display: flex; flex-direction: column; gap: 0.5rem; box-sizing: border-box;">
            <span style="color: #94a3b8; font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">Total Programadas</span>
            <span style="font-size: 2rem; font-weight: 800; color: #38bdf8;">@totalProgramadas</span>
        </div>

        <div style="background-color: #1e293b; border: 1px solid #334155; padding: 1.25rem; border-radius: 12px; display: flex; flex-direction: column; gap: 0.5rem; box-sizing: border-box;">
            <span style="color: #94a3b8; font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">Activas</span>
            <span style="font-size: 2rem; font-weight: 800; color: #4ade80;">@tareasActivas</span>
        </div>

        <div style="background-color: #1e293b; border: 1px solid #334155; padding: 1.25rem; border-radius: 12px; display: flex; flex-direction: column; gap: 0.5rem; box-sizing: border-box;">
            <span style="color: #94a3b8; font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">Pendientes / Pausadas</span>
            <span style="font-size: 2rem; font-weight: 800; color: #facc15;">@tareasPausadas</span>
        </div>

    </div>

    <!-- Listado / Tabla de Tareas Programadas -->
    <div style="background-color: #1e293b; border: 1px solid #334155; padding: 1.25rem; border-radius: 12px; display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem; box-sizing: border-box; width: 100%; max-width: 100%;">
        
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; border-bottom: 1px solid #334155; padding-bottom: 0.75rem;">
            <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #f8fafc; word-break: break-word;">Listado de Programaciones</h3>
            <button @onclick='() => Navigation.NavigateTo("programar-tarea")' style="background-color: transparent; color: #f8fafc; border: 1px solid #64748b; border-radius: 6px; padding: 0.4rem 0.9rem; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;">
                <span>➕</span> Nueva Programación
            </button>
        </div>

        <div style="overflow-x: auto; width: 100%;">
            @if (cargando)
            {
                <div style="text-align: center; color: #94a3b8; padding: 2rem;">Cargando tareas programadas...</div>
            }
            else if (listaProgramadas == null || !listaProgramadas.Any())
            {
                <div style="text-align: center; color: #94a3b8; padding: 2rem;">No hay tareas programadas en este rango de fechas.</div>
            }
            else
            {
                <table style="width: 100%; border-collapse: collapse; text-align: left; color: #f8fafc; font-size: 0.9rem;">
                    <thead>
                        <tr style="border-bottom: 1px solid #334155; color: #94a3b8;">
                            <th style="padding: 0.75rem;">Título / Tarea</th>
                            <th style="padding: 0.75rem;">Frecuencia / Detalle</th>
                            <th style="padding: 0.75rem;">Fecha Programada</th>
                            <th style="padding: 0.75rem;">Estado</th>
                            <th style="padding: 0.75rem; text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tarea in listaProgramadas)
                        {
                            <tr style="border-bottom: 1px solid #334155;">
                                <td style="padding: 0.75rem; font-weight: 600;">@tarea.Titulo</td>
                                <td style="padding: 0.75rem;"><span style="background: #334155; color: #cbd5e1; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem;">@tarea.Descripcion</span></td>
                                <td style="padding: 0.75rem; color: #94a3b8;">@(tarea.FechaProgramada?.ToString("dd-MM-yyyy HH:mm") ?? "Sin fecha")</td>
                                <td style="padding: 0.75rem;">
                                    <span style="color: #4ade80; font-weight: 600;">● Programada</span>
                                </td>
                                <td style="padding: 0.75rem; text-align: right;">
                                    <button style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); padding: 0.3rem 0.5rem; border-radius: 4px; cursor: pointer; margin-right: 0.3rem;" title="Editar">✏️</button>
                                    <button style="background: rgba(239, 68, 68, 0.15); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.3rem 0.5rem; border-radius: 4px; cursor: pointer;" title="Eliminar">🗑️</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

    </div>

</div>

@code {
    [Parameter] public DateTime FechaInicio { get; set; } = new DateTime(2026, 8, 1);
    [Parameter] public DateTime FechaFin { get; set; } = new DateTime(2026, 9, 30);

    private bool cargando = true;
    private List<Organizacion> listaOrganizaciones = new();
    private string orgActual = "";
    private List<Registro> listaProgramadas = new();

    private int totalProgramadas;
    private int tareasActivas;
    private int tareasPausadas;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosInicialesAsync();
    }

    private async Task CargarDatosInicialesAsync()
    {
        cargando = true;
        try
        {
            string idUsuarioActual = await JS.InvokeAsync<string>("localStorage.getItem", "usuario_id");

            if (string.IsNullOrEmpty(idUsuarioActual) || !int.TryParse(idUsuarioActual, out int usuarioIdInt))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            listaOrganizaciones = await DataService.ObtenerOrganizacionesPorUsuarioAsync(usuarioIdInt);

            if (listaOrganizaciones != null && listaOrganizaciones.Any())
            {
                if (string.IsNullOrEmpty(orgActual) || !listaOrganizaciones.Any(o => o.Id == orgActual))
                {
                    orgActual = listaOrganizaciones.First().Id;
                }
                
                await CargarTareasProgramadasAsync();
            }
            else
            {
                listaOrganizaciones = new List<Organizacion>();
                orgActual = string.Empty;
                LimpiarMetricas();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Error Inicialización Tareas Programadas]: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CambiarOrganizacion(ChangeEventArgs e)
    {
        orgActual = e.Value?.ToString() ?? "";
        if (!string.IsNullOrEmpty(orgActual))
        {
            await CargarTareasProgramadasAsync();
        }
        else
        {
            LimpiarMetricas();
        }
    }

    private string ObtenerNombreOrganizacionActiva()
    {
        var org = listaOrganizaciones?.FirstOrDefault(o => o.Id == orgActual);
        return org?.Nombre ?? "Seleccione una organización";
    }

    private async Task CargarTareasProgramadasAsync()
    {
        if (string.IsNullOrEmpty(orgActual)) return;

        cargando = true;
        try
        {
            var resultado = await DataService.ObtenerTareasProgramadasAsync(orgActual, FechaInicio, FechaFin);
            listaProgramadas = resultado ?? new List<Registro>();
            CalcularMetricas();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar tareas programadas: {ex.Message}");
            listaProgramadas = new List<Registro>();
            LimpiarMetricas();
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void CalcularMetricas()
    {
        totalProgramadas = listaProgramadas.Count;
        tareasActivas = listaProgramadas.Count(t => !string.IsNullOrEmpty(t.Titulo));
        tareasPausadas = 0; 
    }

    private void LimpiarMetricas()
    {
        totalProgramadas = 0;
        tareasActivas = 0;
        tareasPausadas = 0;
        listaProgramadas.Clear();
    }
}