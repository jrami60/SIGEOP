@page "/forgot-password"
@layout EmptyLayout
@inject DataService DataSvc
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using System.ComponentModel.DataAnnotations

<div class="card shadow-sm border-0 p-4" style="width: 100%; max-width: 420px; border-radius: 1rem; background-color: #ffffff;">
    
    <div class="text-center mb-4">
        <h3 class="fw-bold text-dark mb-1" style="font-size: 1.75rem;">Recuperar Cuenta</h3>
        <p class="text-muted small">Tablero de Turnos</p>
    </div>

    @if (correoEnviado)
    {
        <div class="alert alert-success text-center py-4 rounded-3 shadow-sm" role="alert">
            <h5 class="fw-bold text-success mb-2">¡Solicitud Procesada!</h5>
            <p class="text-dark small mb-0">Si el correo se encuentra registrado, recibirá las instrucciones para restablecer su contraseña. Redirigiendo...</p>
        </div>
    }
    else
    {
        <EditForm Model="@modelo" OnValidSubmit="ProcesarRecuperacion">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label text-dark fw-semibold small">Correo Electrónico Registrado</label>
                <InputText @bind-Value="modelo.Email" class="form-control" placeholder="correo@santiago.cl" />
                <ValidationMessage For="@(() => modelo.Email)" class="text-danger small mt-1" />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm mb-3">Enviar Instrucciones</button>

            <div class="text-center">
                <a href="/login" class="text-muted small text-decoration-none">← Volver al inicio de sesión</a>
            </div>
        </EditForm>
    }
</div>

@code {
    private RecuperacionDto modelo = new();
    private bool correoEnviado = false;

    private async Task ProcesarRecuperacion()
    {
        bool existe = await DataSvc.VerificarCorreoExisteAsync(modelo.Email);

        correoEnviado = true;
        StateHasChanged();

        await Task.Delay(3000);
        Navigation.NavigateTo("/login");
    }

    public class RecuperacionDto
    {
        [Required(ErrorMessage = "El email es obligatorio."), EmailAddress(ErrorMessage = "Formato de email inválido.")]
        public string Email { get; set; } = "";
    }
}