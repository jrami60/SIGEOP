@page "/dashboard"
@using SistemaGestionWeb.UI.Models
@using SistemaGestionWeb.UI.Services
@inject DataService DataSvc
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div style="width: 100%; box-sizing: border-box; overflow-x: hidden; padding: 0 1rem;">

    <!-- Contenedor Centrado General (Ancho máximo 900px) -->
    <div style="max-width: 900px; margin: 1rem auto; display: flex; flex-direction: column; gap: 1rem; width: 100%; box-sizing: border-box;">

        <!-- Cabecera y Selector de Vista -->
        <div class="d-flex justify-content-between align-items-start align-items-md-center flex-column flex-md-row gap-3" style="width: 100%;">
            <div>
                <h2 style="font-weight: 800; color: #f8fafc; margin-bottom: 0.25rem; font-size: clamp(1.25rem, 4vw, 1.75rem); word-break: break-word;">Dashboard Analítico</h2>
                <p style="color: #94a3b8; font-size: 0.95rem; margin: 0;">Métricas de rendimiento y flujos de turnos en tiempo real.</p>
            </div>
            
            <div style="width: 100%; max-width: 220px;">
                <select class="form-select bg-dark text-white border-secondary shadow-sm" @bind="vistaSeleccionada">
                    <option value="normales">Tareas Operativas</option>
                    <option value="programadas">Tareas Programadas</option>
                </select>
            </div>
        </div>

        <!-- Filtros de Fecha y Descarga Compartidos (Ajustados para evitar desbordes) -->
        <div style="background-color: #1e293b; border: 1px solid #334155; padding: 1.25rem; border-radius: 12px; display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; box-sizing: border-box; width: 100%;">
            <div style="flex: 1; min-width: 140px;">
                <label style="font-size: 0.85rem; color: #94a3b8; display: block; margin-bottom: 0.3rem;">Fecha Inicio:</label>
                <input type="date" @bind="fechaInicio" style="background-color: #0f172a; color: #f8fafc; border: 1px solid #334155; border-radius: 8px; padding: 0.5rem; width: 100%; box-sizing: border-box;" />
            </div>
            <div style="flex: 1; min-width: 140px;">
                <label style="font-size: 0.85rem; color: #94a3b8; display: block; margin-bottom: 0.3rem;">Fecha Fin:</label>
                <input type="date" @bind="fechaFin" style="background-color: #0f172a; color: #f8fafc; border: 1px solid #334155; border-radius: 8px; padding: 0.5rem; width: 100%; box-sizing: border-box;" />
            </div>
            <div style="width: 100%; sm:width: auto;">
                @if (vistaSeleccionada == "normales")
                {
                    <button @onclick="DescargarReporteExcel" style="background-color: #059669; color: white; border: none; border-radius: 8px; padding: 0.55rem 1.2rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; box-sizing: border-box;">
                        <span>📥</span> Descargar Reporte Operativo (CSV)
                    </button>
                }
                else
                {
                    <button @onclick="DescargarReporteProgramadas" style="background-color: #059669; color: white; border: none; border-radius: 8px; padding: 0.55rem 1.2rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; width: 100%; box-sizing: border-box;">
                        <span>📥</span> Descargar Reporte Programadas (CSV)
                    </button>
                }
            </div>
        </div>

        @if (vistaSeleccionada == "normales")
        {
            <!-- Selector Dinámico de Organización Estilizado -->
            <div style="background-color: #1e293b; padding: 1.25rem; border-radius: 12px; border: 1px solid #334155; display: flex; flex-direction: column; gap: 0.75rem; box-sizing: border-box; width: 100%;">
                <span style="color: #94a3b8; font-weight: 600; font-size: 0.9rem;">Organización Activa:</span>
                
                <div style="position: relative; width: 100%;">
                    <select @onchange="CambiarOrganizacion" style="width: 100%; background-color: #0f172a; color: #38bdf8; border: 1px solid #334155; padding: 0.75rem 1rem; border-radius: 8px; font-size: 1rem; font-weight: 600; outline: none; cursor: pointer; appearance: none;">
                        @if (listaOrganizaciones != null && listaOrganizaciones.Any())
                        {
                            @foreach (var org in listaOrganizaciones)
                            {
                                <option value="@org.Id" selected="@(org.Id == orgActual)">@org.Nombre</option>
                            }
                        }
                        else
                        {
                            <option value="">No hay organizaciones autorizadas</option>
                        }
                    </select>
                    <span style="position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); color: #38bdf8; pointer-events: none; font-size: 0.9rem;">▼</span>
                </div>

                <div style="color: #94a3b8; font-size: 0.85rem; margin-top: 0.25rem;">
                    Mostrando datos para: <span style="color: #f8fafc; font-weight: 600;">@(listaOrganizaciones.FirstOrDefault(o => o.Id == orgActual)?.Nombre ?? "Ninguna")</span>
                </div>
            </div>

            @if (cargando)
            {
                <div style="background-color: #1e293b; border: 1px solid #334155; padding: 2rem; border-radius: 12px; text-align: center; color: #94a3b8; box-sizing: border-box; width: 100%;">
                    Cargando métricas operativas...
                </div>
            }
            else
            {
                <!-- Fila de Tarjetas KPI -->
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; width: 100%; box-sizing: border-box;">
                    
                    <div style="background-color: #1e293b; border: 1px solid #334155; padding: 1.25rem; border-radius: 12px; display: flex; flex-direction: column; gap: 0.5rem; box-sizing: border-box;">
                        <span style="color: #94a3b8; font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">Total Tareas</span>
                        <span style="font-size: 2rem; font-weight: 800; color: #f8fafc;">@totalTareas</span>
                    </div>

                    <div style="background-color: #1e293b; border: 1px solid #334155; padding: 1.25rem; border-radius: 12px; display: flex; flex-direction: column; gap: 0.5rem; box-sizing: border-box;">
                        <span style="color: #94a3b8; font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">Completadas</span>
                        <span style="font-size: 2rem; font-weight: 800; color: #4ade80;">@tareasCompletadas</span>
                    </div>

                    <div style="background-color: #1e293b; border: 1px solid #334155; padding: 1.25rem; border-radius: 12px; display: flex; flex-direction: column; gap: 0.5rem; box-sizing: border-box;">
                        <span style="color: #94a3b8; font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">Pendientes</span>
                        <span style="font-size: 2rem; font-weight: 800; color: #facc15;">@tareasPendientes</span>
                    </div>

                    <div style="background-color: #1e293b; border: 1px solid #334155; padding: 1.25rem; border-radius: 12px; display: flex; flex-direction: column; gap: 0.5rem; box-sizing: border-box;">
                        <span style="color: #94a3b8; font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">% Cumplimiento Global</span>
                        <span style="font-size: 2rem; font-weight: 800; color: #38bdf8;">@porcentajeCumplimiento%</span>
                    </div>
                </div>

                <!-- Cumplimiento por Categoría -->
                <div style="background-color: #1e293b; border: 1px solid #334155; padding: 1.25rem; border-radius: 12px; display: flex; flex-direction: column; gap: 1rem; box-sizing: border-box; width: 100%;">
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #f8fafc; word-break: break-word;">Cumplimiento por Categoría</h3>
                    
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; width: 100%; box-sizing: border-box;">
                        @foreach (var cat in metricasCategorias)
                        {
                            <div style="background: #0f172a; border: 1px solid #334155; padding: 1rem; border-radius: 8px; display: flex; flex-direction: column; gap: 0.5rem; box-sizing: border-box; width: 100%;">
                                <div style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem;">
                                    <span style="font-weight: 600; color: #f8fafc; word-break: break-word;">@cat.NombreCategoria</span>
                                    <span style="font-weight: 700; color: #38bdf8; flex-shrink: 0;">@cat.Porcentaje%</span>
                                </div>
                                <div style="width: 100%; background: #334155; height: 8px; border-radius: 4px; overflow: hidden; box-sizing: border-box;">
                                    <div style="width: @(cat.Porcentaje)%; background: #38bdf8; height: 100%;"></div>
                                </div>
                                <span style="font-size: 0.8rem; color: #94a3b8;">@cat.Completadas de @cat.Total completadas</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Sección de Actividad Reciente -->
                <div style="background-color: #1e293b; border: 1px solid #334155; padding: 1.25rem; border-radius: 12px; display: flex; flex-direction: column; gap: 1rem; box-sizing: border-box; width: 100%;">
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: #f8fafc; word-break: break-word;">Últimos Registros Operativos</h3>

                    <div style="display: flex; flex-direction: column; gap: 0.75rem; width: 100%; box-sizing: border-box;">
                        @foreach (var tarea in ultimosRegistros)
                        {
                            <div style="background: #0f172a; border: 1px solid #334155; border-radius: 8px; padding: 1rem; display: flex; flex-direction: column; gap: 0.75rem; box-sizing: border-box; width: 100%;">
                                
                                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; width: 100%;">
                                    <span style="font-weight: 700; color: #38bdf8; font-size: 0.9rem; word-break: break-word;">
                                        @if (categoriasDict.TryGetValue(tarea.CategoriaId, out var catNombre))
                                        {
                                            @catNombre
                                        }
                                        else
                                        {
                                            @("General")
                                        }
                                    </span>
                                    <span style="font-size: 0.8rem; color: #94a3b8; flex-shrink: 0;">@tarea.FechaCreacion.ToShortDateString()</span>
                                </div>

                                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; width: 100%;">
                                    <span style="color: #f8fafc; font-size: 0.95rem; font-weight: 500; word-break: break-word; flex: 1; min-width: 120px;">@tarea.Titulo</span>
                                    <div>
                                        @if (tarea.EstadoId == 3)
                                        {
                                            <span style="background: #dcfce7; color: #15803d; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: 600; font-size: 0.75rem; white-space: nowrap;">Completado</span>
                                        }
                                        else
                                        {
                                            <span style="background: #fef9c3; color: #ca8a04; padding: 0.2rem 0.6rem; border-radius: 4px; font-weight: 600; font-size: 0.75rem; white-space: nowrap;">Pendiente</span>
                                        }
                                    </div>
                                </div>

                                @if (esAdminActual)
                                {
                                    <div style="border-top: 1px solid #334155; padding-top: 0.75rem; display: flex; justify-content: flex-end; align-items: center; gap: 0.5rem; flex-wrap: wrap; width: 100%; box-sizing: border-box;">
                                        @if (tarea.EstadoId == 3)
                                        {
                                            <button style="background-color: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: 6px; font-weight: 600; cursor: pointer; flex: 1; box-sizing: border-box;" 
                                                    @onclick="() => VerDetalleTarea(tarea.Id)">
                                                Ver Detalle
                                            </button>

                                            <button style="background-color: rgba(234, 179, 8, 0.15); color: #fde047; border: 1px solid rgba(234, 179, 8, 0.3); padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: 6px; font-weight: 600; cursor: pointer; flex: 1; box-sizing: border-box;" 
                                                    @onclick="() => CambiarEstadoPendienteAsync(tarea.Id)">
                                                Reabrir
                                            </button>

                                            <button style="background-color: rgba(148, 163, 184, 0.15); color: #cbd5e1; border: 1px solid rgba(148, 163, 184, 0.3); padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: 6px; font-weight: 600; cursor: pointer; flex: 1; box-sizing: border-box;" 
                                                    @onclick="() => ArchivarTareaAsync(tarea.Id)">
                                                Archivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button style="background-color: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: 6px; font-weight: 600; cursor: pointer; flex: 1; box-sizing: border-box;" 
                                                    @onclick="() => IrAEditarTarea(tarea.Id)">
                                                Editar
                                            </button>

                                            <button style="background-color: rgba(239, 68, 68, 0.15); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3); padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: 6px; font-weight: 600; cursor: pointer; flex: 1; box-sizing: border-box;" 
                                                    @onclick="() => EliminarTareaModalAsync(tarea.Id)">
                                                Eliminar
                                            </button>
                                        }
                                    </div>
                                }

                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <DashboardTareasProg />
        }

    </div>

</div>

@code {

    private string vistaSeleccionada = "normales";
    private bool cargando = true;
    private bool esAdminActual = false;
    private string orgActual = "";
    private List<Organizacion> listaOrganizaciones = new();

    private Dictionary<int, string> usuariosDict = new();

    private int totalTareas = 0;
    private int tareasCompletadas = 0;
    private int tareasPendientes = 0;
    private int porcentajeCumplimiento = 0;

    private Dictionary<int, string> categoriasDict = new();
    private List<MetricaCategoria> metricasCategorias = new();
    private List<Registro> ultimosRegistros = new();

    protected override async Task OnParametersSetAsync()
    {
        await CargarDatosInicialesAsync();
    }

    private async Task CargarDatosInicialesAsync()
    {
        cargando = true;
        try
        {
            string idUsuarioActual = await JS.InvokeAsync<string>("localStorage.getItem", "usuario_id");

            if (string.IsNullOrEmpty(idUsuarioActual) || !int.TryParse(idUsuarioActual, out int usuarioIdInt))
            {
                Navigation.NavigateTo("/login");
                return;
            }

            listaOrganizaciones = await DataSvc.ObtenerOrganizacionesPorUsuarioAsync(usuarioIdInt);


            if (listaOrganizaciones != null && listaOrganizaciones.Any())
            {
                if (string.IsNullOrEmpty(orgActual) || !listaOrganizaciones.Any(o => o.Id == orgActual))
                {
                    orgActual = listaOrganizaciones.First().Id;
                }

                await VerificarYCargarMetricasAsync(usuarioIdInt);
            }
            else
            {
                listaOrganizaciones = new List<Organizacion>();
                orgActual = string.Empty;
                esAdminActual = false;
                LimpiarMetricas();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Error Inicialización Dashboard]: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CambiarOrganizacion(ChangeEventArgs e)
    {
        orgActual = e.Value?.ToString() ?? "";
        if (!string.IsNullOrEmpty(orgActual))
        {
            string idUsuarioActual = await JS.InvokeAsync<string>("localStorage.getItem", "usuario_id");
            if (int.TryParse(idUsuarioActual, out int usuarioIdInt))
            {
                await VerificarYCargarMetricasAsync(usuarioIdInt);
            }
        }
        else
        {
            esAdminActual = false;
            LimpiarMetricas();
        }
    }

    private async Task VerificarYCargarMetricasAsync(int usuarioIdInt)
    {
        try
        {
            var orgsUsuario = await DataSvc.ObtenerOrganizacionesPorUsuarioAsync(usuarioIdInt);

            var orgActualObj = orgsUsuario?.FirstOrDefault(o => o.Id == orgActual);

            if (orgActualObj != null && 
                !string.IsNullOrEmpty(orgActualObj.Rol) &&
                (orgActualObj.Rol.Equals("admin", StringComparison.OrdinalIgnoreCase) ||
                orgActualObj.Rol.Equals("administrador", StringComparison.OrdinalIgnoreCase)))
            {
                esAdminActual = true;
            }
            else
            {
                esAdminActual = false;
            }
        }
        catch
        {
            esAdminActual = false;
        }

        await CargarMetricasAsync();
    }

    private async Task CargarMetricasAsync()
    {
        if (string.IsNullOrEmpty(orgActual)) return;

        try
        {
            string idUsuarioStr = await JS.InvokeAsync<string>("localStorage.getItem", "usuario_id");
            int.TryParse(idUsuarioStr, out int usuarioActualId);

            var listaCategorias = await DataSvc.ObtenerCategoriasAsync();
            var listaRegistros = await DataSvc.ObtenerRegistrosActivosParaDashboardAsync(orgActual);

            categoriasDict = listaCategorias.ToDictionary(c => c.Id, c => c.Nombre);

            if (listaRegistros != null)
            {
                var registrosOperativos = listaRegistros.Where(r => string.IsNullOrEmpty(r.TipoTarea)).ToList();

                List<Registro> registrosPermitidos;
                if (esAdminActual)
                {
                    registrosPermitidos = registrosOperativos.ToList();
                }
                else
                {
                    registrosPermitidos = registrosOperativos
                        .Where(r => r.UsuarioId == null || r.UsuarioId == usuarioActualId)
                        .ToList();
                }

                totalTareas = registrosPermitidos.Count;
                tareasCompletadas = registrosPermitidos.Count(r => r.EstadoId == 3);
                tareasPendientes = totalTareas - tareasCompletadas;
                porcentajeCumplimiento = totalTareas > 0 ? (int)Math.Round((double)tareasCompletadas / totalTareas * 100) : 0;

                metricasCategorias = registrosPermitidos
                    .GroupBy(r => r.CategoriaId)
                    .Select(g => new MetricaCategoria {
                        NombreCategoria = categoriasDict.ContainsKey(g.Key) ? categoriasDict[g.Key] : "General",
                        Total = g.Count(),
                        Completadas = g.Count(r => r.EstadoId == 3),
                        Porcentaje = g.Count() > 0 ? (int)Math.Round((double)g.Count(r => r.EstadoId == 3) / g.Count() * 100) : 0
                    }).ToList();

                ultimosRegistros = registrosPermitidos.OrderByDescending(r => r.Id).Take(5).ToList();
            }
            else
            {
                LimpiarMetricas();
            }
        }
        catch (Exception ex) 
        { 
            Console.WriteLine($"[Error al cargar métricas]: {ex.Message}"); 
        }
    }

    private void LimpiarMetricas()
    {
        totalTareas = 0;
        tareasCompletadas = 0;
        tareasPendientes = 0;
        porcentajeCumplimiento = 0;
        metricasCategorias.Clear();
        ultimosRegistros.Clear();
    }

    private async Task ArchivarTareaAsync(long tareaId)
    {
        bool exito = await DataSvc.ArchivarRegistroAsync((int)tareaId);

        if (exito)
        {
            string idUsuarioActual = await JS.InvokeAsync<string>("localStorage.getItem", "usuario_id");
            if (int.TryParse(idUsuarioActual, out int usuarioIdInt))
            {
                await VerificarYCargarMetricasAsync(usuarioIdInt);
            }
            StateHasChanged();
        }
    }
    private async Task CambiarEstadoPendienteAsync(long tareaId)
    {
        var tareaExistente = await DataSvc.ObtenerRegistroPorIdAsync((int)tareaId);

        if (tareaExistente != null)
        {
            tareaExistente.EstadoId = 1;

            bool exito = await DataSvc.ActualizarTareaAsync(tareaExistente);

            if (exito)
            {
                string idUsuarioActual = await JS.InvokeAsync<string>("localStorage.getItem", "usuario_id");
                if (int.TryParse(idUsuarioActual, out int usuarioIdInt))
                {
                    await VerificarYCargarMetricasAsync(usuarioIdInt);
                }
                StateHasChanged();
            }
        }
    }
    private void VerDetalleTarea(long tareaId)
    {
        Navigation.NavigateTo($"/ver-tarea/{(int)tareaId}");
    }

    private void IrAEditarTarea(long tareaId)
    {
        Navigation.NavigateTo($"/crear-tarea/{(int)tareaId}");
    }

    private async Task EliminarTareaModalAsync(int idTarea)
    {
        bool exito = await DataSvc.EliminarTareaAsync(idTarea);
        if (exito)
        {
            string idUsuarioActual = await JS.InvokeAsync<string>("localStorage.getItem", "usuario_id");
            if (int.TryParse(idUsuarioActual, out int usuarioIdInt))
            {
                await VerificarYCargarMetricasAsync(usuarioIdInt);
            }
        }
    }

    private class MetricaCategoria
    {
        public string NombreCategoria { get; set; } = "";
        public int Total { get; set; }
        public int Completadas { get; set; }
        public int Porcentaje { get; set; }
    }


    private DateTime fechaInicio = DateTime.Today.AddDays(-30);
    private DateTime fechaFin = DateTime.Today;


   private async Task DescargarReporteExcel()
    {
        try
        {
            var todosLosRegistros = await DataSvc.ObtenerRegistrosPorOrganizacionAsync(orgActual);
            if (todosLosRegistros == null) return;

            var registrosParaExportar = todosLosRegistros
                .Where(r => (string.IsNullOrEmpty(r.TipoTarea) || r.TipoTarea != "programada") &&
                            r.FechaCreacion >= fechaInicio && 
                            r.FechaCreacion <= fechaFin.AddDays(1))
                .ToList();

            Dictionary<int, string> usuariosCache = new();

            var csvContent = new System.Text.StringBuilder();
            csvContent.AppendLine("ID;Categoria;Titulo;Estado;Usuario;FechaCreacion");

            foreach (var reg in registrosParaExportar)
            {
                string nombreCategoria = categoriasDict.ContainsKey(reg.CategoriaId) ? categoriasDict[reg.CategoriaId] : "General";

                string nombreEstado = reg.EstadoId switch
                {
                    1 => "Pendiente",
                    2 => "En Curso",
                    3 => "Completado",
                    _ => "Desconocido"
                };

                string tituloLimpo = (reg.Titulo ?? "").Replace("\"", "\"\"");
                
                string nombreUsuario = "Sin Asignar";
                if (reg.UsuarioId.HasValue)
                {
                    int idUser = reg.UsuarioId.Value;
                    if (!usuariosCache.ContainsKey(idUser))
                    {
                        usuariosCache[idUser] = await DataSvc.ObtenerNombreUsuarioPorIdAsync(idUser);
                    }
                    nombreUsuario = usuariosCache[idUser];
                }

                csvContent.AppendLine($"{reg.Id};\"{nombreCategoria}\";\"{tituloLimpo}\";\"{nombreEstado}\";\"{nombreUsuario}\";{reg.FechaCreacion:yyyy-MM-dd HH:mm}");
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(csvContent.ToString());
            var fileName = $"Reporte_Tareas_{orgActual}_{DateTime.Now:yyyyMMdd}.csv";
            
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al exportar: {ex.Message}");
        }
    }

    private async Task DescargarReporteProgramadas()
    {
        try
        {
            var todosLosRegistros = await DataSvc.ObtenerRegistrosPorOrganizacionAsync(orgActual);
            if (todosLosRegistros == null) return;

            var registrosParaExportar = todosLosRegistros
                .Where(r => r.TipoTarea == "programada" && 
                            r.FechaProgramada >= fechaInicio && 
                            r.FechaProgramada <= fechaFin.AddDays(1))
                .ToList();

            Dictionary<int, string> usuariosCache = new();

            var csvContent = new System.Text.StringBuilder();
            csvContent.AppendLine("ID;Titulo;Descripcion;TipoTarea;FechaProgramada;Usuario;Estado");

            foreach (var reg in registrosParaExportar)
            {
                string nombreEstado = reg.EstadoId switch
                {
                    1 => "Pendiente",
                    2 => "En Curso",
                    3 => "Completado",
                    _ => "Desconocido"
                };

                string tituloLimpo = (reg.Titulo ?? "").Replace("\"", "\"\"");
                string descLimpia = (reg.Descripcion ?? "").Replace("\"", "\"\"");

                string nombreUsuario = "Sin Asignar";
                if (reg.UsuarioId.HasValue)
                {
                    int idUser = reg.UsuarioId.Value;
                    if (!usuariosCache.ContainsKey(idUser))
                    {
                        usuariosCache[idUser] = await DataSvc.ObtenerNombreUsuarioPorIdAsync(idUser);
                    }
                    nombreUsuario = usuariosCache[idUser];
                }

                csvContent.AppendLine($"{reg.Id};\"{tituloLimpo}\";\"{descLimpia}\";\"{reg.TipoTarea}\";{reg.FechaProgramada:yyyy-MM-dd HH:mm};\"{nombreUsuario}\";\"{nombreEstado}\"");
            }

            var bytes = System.Text.Encoding.UTF8.GetBytes(csvContent.ToString());
            var fileName = $"Reporte_Programadas_{orgActual}_{DateTime.Now:yyyyMMdd}.csv";
            
            await JS.InvokeVoidAsync("downloadFileFromStream", fileName, Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al exportar tareas programadas: {ex.Message}");
        }
    }
}