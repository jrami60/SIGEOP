@page "/PerfilEquipo"
@using System.Data.Common
@inject DataService DataSvc
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="vista-container py-4" style="max-width: 1350px; width: 100%; margin: 0 auto; padding-left: 1rem; padding-right: 1rem; box-sizing: border-box;">
    <!-- Cabecera -->
    <div class="vista-header mb-4" style="width: 100%; box-sizing: border-box;">
        <h2 class="fw-bold text-light mb-1 d-flex align-items-center gap-2" style="font-size: clamp(1.25rem, 4vw, 1.75rem); flex-wrap: wrap; word-break: break-word;">
            <i class="bi bi-person-gear text-info"></i> Gestión de Perfil y Equipo
        </h2>
        <p class="text-muted mb-0" style="font-size: 0.9rem;">Administra tu seguridad personal y los miembros asociados a tus organizaciones.</p>
    </div>

    <!-- SECCIÓN: CAMBIAR CONTRASEÑA -->
    <div class="card-panel shadow-sm mb-4" style="background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 1.25rem; width: 100%; box-sizing: border-box;">
        <h3 class="card-title h5 fw-bold mb-3" style="color: #38bdf8; font-size: 1.1rem;">
            <i class="bi bi-shield-lock-fill me-1"></i> Seguridad: Cambiar Contraseña
        </h3>
        
        <div class="form-grid-perfil" style="display: flex; flex-direction: column; gap: 1rem; width: 100%; box-sizing: border-box;">
            <div class="form-group-perfil" style="width: 100%; box-sizing: border-box;">
                <label class="form-label-perfil text-secondary small fw-semibold mb-1" style="display: block;">Contraseña Actual</label>
                <input type="password" class="form-input-perfil form-control bg-dark text-light border-secondary" @bind="passwordActual" placeholder="••••••••" style="width: 100%; max-width: 100%; box-sizing: border-box;" />
            </div>
            <div class="form-group-perfil" style="width: 100%; box-sizing: border-box;">
                <label class="form-label-perfil text-secondary small fw-semibold mb-1" style="display: block;">Nueva Contraseña</label>
                <input type="password" class="form-input-perfil form-control bg-dark text-light border-secondary" @bind="passwordNueva" placeholder="••••••••" style="width: 100%; max-width: 100%; box-sizing: border-box;" />
            </div>
            <!-- Botón con color vibrante y destacado -->
            <div style="width: 100%; box-sizing: border-box;">
                <button class="btn-accion-perfil btn btn-info w-100 fw-bold text-dark shadow-sm py-2" @onclick="CambiarPasswordAsync" style="background-color: #38bdf8; border: none; width: 100%; box-sizing: border-box;">
                    <i class="bi bi-key-fill me-1"></i> Actualizar Contraseña
                </button>
            </div>
        </div>
    </div>

    <h3 class="card-title h5 fw-bold mb-3" style="color: #fbbf24; font-size: 1.1rem;">
        <i class="bi bi-people-fill me-1"></i> Miembros por Organización
    </h3>

    @if (cargando)
    {
        <div class="text-center py-4">
            <p class="texto-atenuado text-muted">Cargando organizaciones...</p>
        </div>
    }
    else if (organizacionesConMiembros == null || !organizacionesConMiembros.Any())
    {
        <div class="card-panel text-center py-4" style="background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; width: 100%; box-sizing: border-box;">
            <p class="texto-atenuado text-muted m-0">No estás asociado a ninguna organización activa en este momento.</p>
        </div>
    }
    else
    {
        @foreach (var org in organizacionesConMiembros)
        {
            var esAdminActual = org.RolUsuarioActual.Equals("admin", StringComparison.OrdinalIgnoreCase) || 
                                org.RolUsuarioActual.Equals("administrador", StringComparison.OrdinalIgnoreCase);

            <div class="org-subcard mb-4 shadow-sm" style="background-color: #1e293b; border: 1px solid #334155; border-radius: 12px; overflow: hidden; width: 100%; box-sizing: border-box;">
                
                <!-- Cabecera de la subcard (Local) -->
                <div class="org-subcard-header d-flex justify-content-between align-items-center p-3 border-bottom border-secondary bg-dark" style="flex-wrap: wrap; gap: 0.5rem; width: 100%; box-sizing: border-box;">
                    <h4 class="org-subcard-title h6 fw-bold text-light m-0 d-flex align-items-center gap-2">
                        <i class="bi bi-building text-warning fs-5"></i> 
                        <span style="color: #f1f5f9; font-size: 1rem; word-break: break-word;">@org.NombreOrganizacion</span>
                    </h4>
                    <span class="rol-badge badge bg-warning text-dark fw-bold px-2.5 py-1.5 rounded-pill shadow-sm" style="font-size: 0.75rem;">
                        Tu Rol: @org.RolUsuarioActual.ToUpper()
                    </span>
                </div>
                
                <!-- Contenedor de Miembros (Diseño Adaptativo: Tabla en PC / Bloques flexibles en Celular) -->
                <div class="p-3" style="width: 100%; box-sizing: border-box;">
                    <div style="display: flex; flex-direction: column; gap: 1rem;">
                        @foreach (var miembro in org.Miembros)
                        {
                            <div style="background-color: rgba(15, 23, 42, 0.5); border: 1px solid #334155; border-radius: 8px; padding: 1rem; width: 100%; box-sizing: border-box; display: flex; flex-direction: column; gap: 0.75rem;">
                                
                                <!-- Fila superior del miembro: Nombre y Rol -->
                                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-circle text-info fs-5 flex-shrink-0"></i>
                                        <strong class="text-light" style="font-size: 0.95rem; word-break: break-word;">@miembro.NombreUsuario</strong>
                                    </div>
                                    <span class="rol-badge badge @(miembro.RolEnOrg.Equals("admin", StringComparison.OrdinalIgnoreCase) ? "bg-warning text-dark fw-bold" : "bg-secondary text-light")" style="font-size: 0.75rem; padding: 0.35em 0.6em;">
                                        @miembro.RolEnOrg.ToUpper()
                                    </span>
                                </div>

                                <!-- Fila inferior del miembro: Acciones / Privilegios -->
                                <div style="border-top: 1px solid #334155; padding-top: 0.75rem; display: flex; justify-content: flex-end; align-items: center; width: 100%;">
                                    @if (esAdminActual)
                                    {
                                        <div style="display: flex; align-items: center; gap: 0.5rem; width: 100%; justify-content: flex-end; flex-wrap: wrap;">
                                            <select class="form-input-perfil form-select form-select-sm bg-dark text-light border-secondary shadow-sm" 
                                                    style="flex: 1; min-width: 120px; max-width: 150px; height: 38px; font-size: 0.85rem; cursor: pointer;"
                                                    value="@miembro.RolEnOrg" 
                                                    @onchange="(e) => CambiarRolAsync(org.IdOrganizacion, miembro.IdUsuario, e)">
                                                <option value="miembro">Miembro</option>
                                                <option value="admin">Administrador</option>
                                            </select>

                                            <button class="btn btn-sm d-flex align-items-center justify-content-center gap-1 shadow-sm fw-semibold px-3" 
                                                    style="background-color: #ef4444 !important; border-color: #ef4444 !important; color: #ffffff !important; height: 38px; font-size: 0.85rem; white-space: nowrap;"
                                                    @onclick="() => RemoverMiembroAsync(org.IdOrganizacion, miembro.IdUsuario)">
                                                <i class="bi bi-person-x-fill"></i> Expulsar
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="texto-atenuado text-muted small fst-italic" style="font-size: 0.8rem;">@(miembro.IdUsuario == usuarioIdActual ? "(Tú - Sin permisos de gestión)" : "Sin permisos de gestión")</span>
                                    }
                                </div>

                            </div>
                        }
                    </div>
                </div>

            </div>
        }
    }

    @if (!string.IsNullOrEmpty(mensajeFeedback))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") mt-3 shadow-sm fw-semibold" style="border-radius: 8px;">
            @mensajeFeedback
        </div>
    }
</div>

@code {
    private int usuarioIdActual = 0;
    private string passwordActual = "";
    private string passwordNueva = "";
    private string mensajeFeedback = "";
    private bool esError = false;
    private bool cargando = true;

    private List<OrgConMiembrosDto> organizacionesConMiembros = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosUsuarioAsync();
    }

    private async Task CargarDatosUsuarioAsync()
    {
        cargando = true;
        try
        {
            string idUsuarioActualStr = await JS.InvokeAsync<string>("localStorage.getItem", "usuario_id");
            
            if (int.TryParse(idUsuarioActualStr, out int uId))
            {
                usuarioIdActual = uId;
                organizacionesConMiembros = await DataSvc.ObtenerOrganizacionesParaPerfilAsync(uId);
            }
            else
            {
                mensajeFeedback = "No se encontró una sesión activa.";
                esError = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar datos del equipo: {ex.Message}");
            organizacionesConMiembros = new List<OrgConMiembrosDto>();
        }
        finally
        {
            cargando = false;
        }
    }

   private async Task CambiarRolSeleccionadoAsync(string orgId, int usuarioId, ChangeEventArgs e)
    {
        Console.WriteLine($"[DEBUG Selector] orgId: '{orgId}' | usuarioId: '{usuarioId}'");
        string nuevoRol = e.Value?.ToString() ?? "miembro";
        
        bool actualizado = await DataSvc.ActualizarRolMiembroAsync(orgId, usuarioId, nuevoRol);
        
        if (actualizado)
        {
            mensajeFeedback = $"Se actualizó el rol a {nuevoRol.ToUpper()} con éxito.";
            esError = false;
            await CargarDatosUsuarioAsync();
        }
        else
        {
            mensajeFeedback = "No se pudo actualizar el rol en la base de datos.";
            esError = true;
        }
    }

    private async Task CambiarPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(passwordActual) || string.IsNullOrWhiteSpace(passwordNueva))
        {
            mensajeFeedback = "Debes completar ambos campos de contraseña.";
            esError = true;
            return;
        }

        bool actualizado = await DataSvc.ActualizarPasswordAsync(usuarioIdActual, passwordActual, passwordNueva);
        if (actualizado)
        {
            mensajeFeedback = "¡Contraseña actualizada con éxito!";
            esError = false;
            passwordActual = "";
            passwordNueva = "";
        }
        else
        {
            mensajeFeedback = "Error al actualizar la contraseña.";
            esError = true;
        }
    }

    private async Task RemoverMiembroAsync(string orgId, int miembroId)
    {
        try
        {
            bool exito = await DataSvc.EliminarRelacionUsuarioOrganizacionAsync(miembroId.ToString(), orgId);
            if (exito)
            {
                mensajeFeedback = "Colaborador removido de la organización.";
                esError = false;
                await CargarDatosUsuarioAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al remover miembro: {ex.Message}");
        }
    }
    private async Task CambiarRolPorRelacionAsync(int relacionId, ChangeEventArgs e)
    {
        Console.WriteLine($"[DEBUG] relacionId recibido: '{relacionId}'");
        string nuevoRol = e.Value?.ToString() ?? "miembro";
        
        bool actualizado = await DataSvc.ActualizarRolPorRelacionAsync(relacionId, nuevoRol);
        
        if (actualizado)
        {
            mensajeFeedback = $"Se actualizó el rol a {nuevoRol.ToUpper()} con éxito.";
            esError = false;
            await CargarDatosUsuarioAsync();
        }
        else
        {
            mensajeFeedback = "No se pudo actualizar el rol.";
            esError = true;
        }
    }
    private async Task CambiarRolAsync(string organizacionId, int usuarioId, ChangeEventArgs e)
    {
        string nuevoRol = e.Value?.ToString() ?? "miembro";
        bool actualizado = await DataSvc.ActualizarRolPorOrgYUsuarioAsync(organizacionId, usuarioId, nuevoRol);
        
        if (actualizado)
        {
            mensajeFeedback = $"Se actualizó el rol a {nuevoRol.ToUpper()} con éxito.";
            esError = false;
            await CargarDatosUsuarioAsync();
        }
        else
        {
            mensajeFeedback = "No se pudo actualizar el rol.";
            esError = true;
        }
    }
}